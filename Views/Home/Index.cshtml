@model HarishPortfolio.Models.PortfolioData
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Name — @Model.Role</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

<!-- ───── NAV ───── -->
<nav class="nav">
    <div class="nav-logo">H<span class="dot">.</span></div>
    <ul class="nav-links">
        <li><a href="#about">About</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#contact">Contact</a></li>
    </ul>
    <a href="mailto:@Model.Email" class="btn-nav">Hire Me</a>
</nav>

<!-- ───── HERO ───── -->
<section class="hero" id="home">
    <div class="hero-bg-text">NET</div>
    <div class="hero-content">
        <div class="hero-badge">Available for opportunities</div>
        <h1 class="hero-name">@Model.Name<span class="dot">.</span></h1>
        <p class="hero-role">@Model.Role</p>
        <p class="hero-tagline">@Model.Tagline</p>
        <div class="hero-cta">
            <a href="#projects" class="btn-primary">View Projects</a>
            <a href="#contact" class="btn-outline">Contact Me</a>
        </div>
        <div class="hero-stats">
            <div class="stat">
                <span class="stat-num">4+</span>
                <span class="stat-label">Projects</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat">
                <span class="stat-num">C#</span>
                <span class="stat-label">Primary Lang</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat">
                <span class="stat-num">.NET</span>
                <span class="stat-label">Ecosystem</span>
            </div>
        </div>
    </div>
    <div class="hero-visual">
        <div class="code-card">
            <div class="code-dots"><span></span><span></span><span></span></div>
            <pre><code><span class="c-kw">var</span> developer = <span class="c-kw">new</span> Developer {
  Name    = <span class="c-str">"@Model.Name"</span>,
  Role    = <span class="c-str">"@Model.Role"</span>,
  Stack   = <span class="c-str">"C# · .NET · SQL"</span>,
  Status  = <span class="c-str">"Building great things"</span>
};

<span class="c-kw">await</span> developer<span class="c-op">.</span>BuildAsync();</code></pre>
        </div>
    </div>
</section>

<!-- ───── ABOUT ───── -->
<section class="section" id="about">
    <div class="container">
        <div class="section-label">Who I am</div>
        <h2 class="section-title">About Me</h2>
        <div class="about-grid">
            <div class="about-img-wrap">
                <div class="about-img-placeholder">
                    <span>H</span>
                    <p class="img-hint">Replace with your photo in wwwroot/images/profile.jpg</p>
                </div>
                <!-- When you have a real photo, replace the div above with: -->
                <!-- <img src="~/images/profile.jpg" alt="Harish" class="about-img" /> -->
            </div>
            <div class="about-text">
                <p>@Model.About</p>
                <p>Currently transitioning from <strong>WinForms desktop development</strong> to <strong>ASP.NET Core web development</strong> — combining years of backend .NET expertise with modern web technologies.</p>
                <div class="about-tags">
                    <span class="tag">C# Expert</span>
                    <span class="tag">WinForms</span>
                    <span class="tag">ASP.NET Core</span>
                    <span class="tag">SQL Server</span>
                    <span class="tag">REST APIs</span>
                    <span class="tag">Git</span>
                </div>
                <a href="mailto:@Model.Email" class="btn-primary" style="margin-top:1.5rem;display:inline-block;">Download Resume</a>
            </div>
        </div>
    </div>
</section>

<!-- ───── PROJECTS ───── -->
<section class="section section-dark" id="projects">
    <div class="container">
        <div class="section-label">What I've built</div>
        <h2 class="section-title">Projects</h2>
        <div class="projects-grid">
            @foreach (var project in Model.Projects)
            {
                <div class="project-card">
                    <div class="project-img">
                        <!-- Replace src with your actual image later -->
                        <div class="project-img-placeholder">
                            <span>@project.Name[0]</span>
                        </div>
                        <div class="project-category">@project.Category</div>
                    </div>
                    <div class="project-body">
                        <h3 class="project-name">@project.Name</h3>
                        <p class="project-desc">@project.Description</p>
                        <div class="project-tech">
                            @foreach (var t in project.Tech.Split('·'))
                            {
                                <span class="tech-badge">@t.Trim()</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ───── SKILLS ───── -->
<section class="section" id="skills">
    <div class="container">
        <div class="section-label">What I know</div>
        <h2 class="section-title">Skills</h2>
        <div class="skills-grid">
            @foreach (var skill in Model.Skills)
            {
                <div class="skill-item">
                    <div class="skill-header">
                        <span class="skill-name">@skill.Name</span>
                        <span class="skill-pct">@skill.Level%</span>
                    </div>
                    <div class="skill-bar">
                        <div class="skill-fill" style="width:@skill.Level%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ───── CONTACT ───── -->
<section class="section section-dark" id="contact">
    <div class="container contact-wrap">
        <div class="section-label">Get in touch</div>
        <h2 class="section-title">Contact</h2>
        <p class="contact-sub">Open to full-time roles, freelance projects, and collaborations.</p>
        <div class="contact-cards">
            <a href="mailto:@Model.Email" class="contact-card">
                <div class="contact-icon">✉</div>
                <div>
                    <div class="contact-label">Email</div>
                    <div class="contact-value">@Model.Email</div>
                </div>
            </a>
            <a href="@Model.GitHub" target="_blank" class="contact-card">
                <div class="contact-icon">⌥</div>
                <div>
                    <div class="contact-label">GitHub</div>
                    <div class="contact-value">github.com/harish</div>
                </div>
            </a>
            <a href="@Model.LinkedIn" target="_blank" class="contact-card">
                <div class="contact-icon">in</div>
                <div>
                    <div class="contact-label">LinkedIn</div>
                    <div class="contact-value">linkedin.com/in/harish</div>
                </div>
            </a>
            <div class="contact-card">
                <div class="contact-icon">📍</div>
                <div>
                    <div class="contact-label">Location</div>
                    <div class="contact-value">@Model.Location</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ───── FOOTER ───── -->
<footer class="footer">
    <p>© @DateTime.Now.Year @Model.Name — Built with ASP.NET Core</p>
</footer>

<script src="~/js/site.js"></script>
</body>
</html>
